{
  "name": "ocmlens",
  "displayName": "OCM Lens",
  "icon": "icon.png",
  "description": "Understand an OCM delivery right in your editor: component versions, artifacts, completeness, digests and signatures, with embedded SBOMs. CTF and component archives.",
  "version": "2.0.0",
  "publisher": "everbright-it",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/everbrightit-group/sbom-lens.git"
  },
  "bugs": {
    "url": "https://github.com/EverBright-IT/OCM-Lens/issues"
  },
  "homepage": "https://ocm-lens.everbright-it.de/",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "ocm",
    "open-component-model",
    "component descriptor",
    "ctf",
    "oci",
    "sbom",
    "delivery",
    "supply-chain",
    "signature verification",
    "air-gapped"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onUri"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "ocmlens.viewer",
        "displayName": "OCM Lens",
        "selector": [
          {
            "filenamePattern": "component-descriptor.yaml"
          },
          {
            "filenamePattern": "component-descriptor.yml"
          },
          {
            "filenamePattern": "component-descriptor.json"
          },
          {
            "filenamePattern": "*.ctf"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "ocmlens.viewer",
        "displayName": "OCM Lens",
        "selector": [
          {
            "filenamePattern": "*.tar"
          },
          {
            "filenamePattern": "*.tgz"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "ocmlens.openWith",
        "title": "Open with OCM Lens"
      },
      {
        "command": "ocmlens.openFolder",
        "title": "Open folder with OCM Lens"
      },
      {
        "command": "ocmlens.scanWorkspace",
        "title": "OCM Lens: Scan workspace for component descriptors"
      },
      {
        "command": "ocmlens.openFromRegistry",
        "title": "Open component version from registry...",
        "category": "OCM Lens"
      },
      {
        "command": "ocmlens.setRegistryCredential",
        "title": "Set registry credential...",
        "category": "OCM Lens"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "ocmlens.openWith",
          "when": "!explorerResourceIsFolder && resourceFilename =~ /(component-descriptor\\.(ya?ml|json)|\\.(ctf|tar|tgz))$/",
          "group": "navigation@50"
        },
        {
          "command": "ocmlens.openFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation@51"
        }
      ],
      "commandPalette": [
        {
          "command": "ocmlens.openWith",
          "when": "false"
        },
        {
          "command": "ocmlens.openFolder",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "OCM Lens",
      "properties": {
        "ocmlens.registries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "OCI registries offered by **OCM Lens: Open component version from registry** (e.g. `ghcr.io/open-component-model/ocm`). For private registries, store a per-host `user:token` credential via **OCM Lens: Set registry credential**."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compile": "node esbuild.mjs && rm -rf media && cp -R ../ocm-lens/dist-vscode media && cp ../../LICENSE . && cp ../ocm-lens/CHANGELOG.md .",
    "package": "vsce package --no-dependencies -o ../../ocmlens.vsix",
    "package:pre": "vsce package --no-dependencies --pre-release -o ../../ocmlens.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.6"
  }
}
